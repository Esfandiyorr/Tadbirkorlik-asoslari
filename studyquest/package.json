{
  "name": "tadbirkorlik-asoslari",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-legacy.mjs && next dev --hostname 0.0.0.0",
    "dev:demo": "STUDYQUEST_DEMO=true npm run dev",
    "build": "node scripts/sync-legacy.mjs --production && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-studyquest \"npm run test:rules\"",
    "test:browser": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "pretypecheck": "node scripts/sync-legacy.mjs",
    "pretest": "node scripts/sync-legacy.mjs",
    "format:check": "prettier --check app components lib scripts tests *.ts *.json docs README.md public/*.js public/*.html public/*.webmanifest"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "@tailwindcss/postcss": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "morphdom": "^2.7.8",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.34.2",
    "prettier": "^3.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@grpc/grpc-js@<1.13.6": "^1.14.7",
    "uuid@<11.1.1": "^11.1.1"
  }
}
