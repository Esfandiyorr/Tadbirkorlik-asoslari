# Never set DEMO on a public deployment. Demo data lives only in .studyquest-demo/.
STUDYQUEST_DEMO=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Server only. Prefer workload identity / application default credentials where available.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
# Optional additional owner Firebase UIDs. Verified isfandiyor2198@gmail.com is the owner.
STUDYQUEST_ADMIN_UIDS=
# Used by the one-time administrator bootstrap script, never the frontend.
BOOTSTRAP_ADMIN_UID=

# Public by default. Prefer the administrator Platforma tab for runtime access controls.
# The old PLATFORM_ADMIN_ONLY variable is no longer used.
PLATFORM_MAINTENANCE=false
# Optional server-only signing secret when using ADC instead of FIREBASE_PRIVATE_KEY.
PLATFORM_ACCESS_SECRET=
# Optional, server only: Claude API key for grading the topic 8 logo assignment (console.anthropic.com).
# Without it submissions are saved and queued for the teacher; never expose it as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
