# Never set DEMO on a public deployment. Demo data lives only in .studyquest-demo/.
STUDYQUEST_DEMO=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Server only. Prefer workload identity / application default credentials where available.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=
# Optional comma-separated Firebase auth UIDs for platform administrators.
STUDYQUEST_ADMIN_UIDS=
# Used by the one-time administrator bootstrap script, never the frontend.
BOOTSTRAP_ADMIN_UID=
